# ─────────────────────────────────────────────────────────────
# Gearly backend — environment variables
# Copy to `.env` and fill in.  `.env` is git-ignored.
# Vars WITHOUT a default in application.properties are REQUIRED:
# the app fails to boot loudly if they are unset.
# Both `mvn spring-boot:run` (export these first) and docker-compose
# (reads backend/.env automatically) consume this file.
# ─────────────────────────────────────────────────────────────

# JWT signing secret (base64). REQUIRED.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# Google OAuth client id ("Login with Google"). REQUIRED.
GOOGLE_CLIENT_ID=

# SMTP / email. Host+port default to Gmail; username+password REQUIRED.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# MongoDB connection URI. Optional (defaults to local mongodb://localhost:27017/bookify).
# docker-compose overrides this to point at the mongodb service.
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/bookify

# MoMo payment gateway. partnerCode/returnUrl have defaults; keys REQUIRED.
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=http://localhost:5173/momo-return
# Public URL MoMo calls back (e.g. an ngrok/tunnel URL). Optional.
MOMO_NOTIFY_URL=

# GitHub Models (AI chat + intent classification). Optional; AI features
# are inert without a token.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_SECOND_TOKEN=

# CORS allowed origins (comma-separated): storefront + admin dev servers.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
